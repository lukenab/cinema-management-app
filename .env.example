# Copy to .env.local (git-ignored) and fill in.

# ── App (bundled into the app; never put secrets here) ──
# Android emulator reaches the dev server (Metro) at 10.0.2.2. Physical phone: http://<your-LAN-IP>:8081
EXPO_PUBLIC_API_URL=http://10.0.2.2:8081

# ── Server only (read by src/server, never bundled: no EXPO_PUBLIC_ prefix) ──
# MongoDB Atlas: Connect > Drivers. Include the database name before the "?".
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/cineprime?retryWrites=true&w=majority
# Random string, 64+ characters.
JWT_SECRET=
# TMDB v3 API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
# Optional: admin account created on first run (default admin / admin)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
# Demo customer created on first run (default user / user)
# DEMO_USERNAME=user
# DEMO_PASSWORD=user

# VNPay (sandbox: https://sandbox.vnpayment.vn/devreg). Required for payments unless PAYMENT_MODE=internal.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# PAYMENT_MODE=internal   # CinePrime's own checkout page instead of VNPay (environments without VNPay credentials)
# Base URL VNPay redirects the customer's browser back to. Defaults to the host the app called (10.0.2.2:8081 on the emulator).
# PUBLIC_BASE_URL=http://192.168.1.10:8081

# Gemini for "Đặt vé nhanh" (https://aistudio.google.com/apikey). Empty = a rule-based picker answers instead.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
